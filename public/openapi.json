{
  "openapi": "3.1.0",
  "info": {
    "title": "NIFTY Liquidity Swing API",
    "description": "Authenticated endpoint that selects the highest-volume NIFTY call and put, analyzes their swing highs, and stores the results in Turso.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/nifty-option-chain": {
      "get": {
        "summary": "Get the highest-volume NIFTY CALL and PUT",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Highest-volume instruments selected from the current NIFTY option chain.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NiftyOptionChainResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token."
          },
          "405": {
            "description": "Only GET is supported."
          },
          "500": {
            "description": "The API environment is not configured."
          },
          "502": {
            "description": "The Kotak option-chain request failed."
          }
        }
      }
    },
    "/api/liquidity-swing": {
      "get": {
        "summary": "Select and analyze the highest-volume NIFTY call and put",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Selected instruments and swing-high analysis, persisted to Turso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SwingResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token."
          },
          "405": {
            "description": "Only GET is supported."
          },
          "500": {
            "description": "The API environment is not configured."
          },
          "502": {
            "description": "The option-chain request or historical-candle analysis failed."
          },
          "503": {
            "description": "Swing analysis succeeded, but storing it in Turso failed."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "SelectedInstrument": {
        "type": "object",
        "required": [
          "optionType",
          "symbol",
          "token",
          "volume"
        ],
        "properties": {
          "optionType": {
            "type": "string",
            "enum": ["CE", "PE"]
          },
          "symbol": {
            "type": "string"
          },
          "token": {
            "type": "string",
            "pattern": "^nse_fo\\|[A-Za-z0-9._-]+$",
            "example": "nse_fo|45402"
          },
          "volume": {
            "type": "number"
          }
        }
      },
      "NiftyOptionChainResponse": {
        "type": "object",
        "required": [
          "call",
          "put"
        ],
        "properties": {
          "call": {
            "$ref": "#/components/schemas/SelectedInstrument"
          },
          "put": {
            "$ref": "#/components/schemas/SelectedInstrument"
          }
        }
      },
      "SwingResponse": {
        "type": "object",
        "required": [
          "scanId",
          "insertedRows",
          "selected",
          "analyses"
        ],
        "properties": {
          "scanId": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier shared by both stored option results."
          },
          "insertedRows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "description": "Number of new rows inserted; duplicate pivot identities are skipped."
          },
          "selected": {
            "type": "object",
            "required": [
              "call",
              "put"
            ],
            "properties": {
              "call": {
                "$ref": "#/components/schemas/SelectedInstrument"
              },
              "put": {
                "$ref": "#/components/schemas/SelectedInstrument"
              }
            }
          },
          "analyses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SwingAnalysis"
            }
          }
        }
      },
      "SwingAnalysis": {
        "type": "object",
        "required": [
          "optionSide",
          "symbol",
          "token",
          "optionVolume",
          "interval",
          "pivotLookback",
          "bars",
          "swing"
        ],
        "properties": {
          "optionSide": {
            "type": "string",
            "enum": [
              "CALL",
              "PUT"
            ]
          },
          "token": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "optionVolume": {
            "type": "number"
          },
          "interval": {
            "type": "string",
            "example": "1min"
          },
          "pivotLookback": {
            "type": "integer",
            "example": 5
          },
          "bars": {
            "type": "integer",
            "description": "Number of historical candles analyzed."
          },
          "swing": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SwingHigh"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "SwingHigh": {
        "type": "object",
        "required": [
          "side",
          "pivotTime",
          "confirmedAt",
          "level",
          "zoneTop",
          "zoneBottom",
          "intersectionCount",
          "intersectionVolume",
          "status"
        ],
        "properties": {
          "side": {
            "type": "string",
            "enum": [
              "high"
            ]
          },
          "pivotTime": {
            "type": "string",
            "format": "date-time"
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time"
          },
          "level": {
            "type": "number"
          },
          "zoneTop": {
            "type": "number"
          },
          "zoneBottom": {
            "type": "number"
          },
          "intersectionCount": {
            "type": "integer"
          },
          "intersectionVolume": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "tracking",
              "qualified",
              "broken"
            ]
          },
          "brokenAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}

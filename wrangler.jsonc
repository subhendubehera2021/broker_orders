{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nifty-cron",
	"main": "src/index.js",
	"compatibility_date": "2026-11-16",
	"durable_objects": {
		"bindings": [
			{
				"name": "ORDER_STREAM",
				"class_name": "KotakOrderStream"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["KotakOrderStream"]
		}
	],
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issues": {
			"enabled": true
		}
	},
	"triggers": {
		"crons": [
			"* * * * *",
			"*/5 * * * *"
		]
	}
}
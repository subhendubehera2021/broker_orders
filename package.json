{
  "name": "minute-cron",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:pm2": "npm run build && pm2 start dist/server.js --name minute-cron",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pm2": "^7.1.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "glob": "^14.0.3"
  }
}
